{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Service API",
    "version": "1.0.0",
    "description": "CRUD API for tasks built with clean architecture."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Operations with tasks"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List tasks",
        "responses": {
          "200": {
            "description": "Task list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskRequest" },
              "examples": {
                "daily": {
                  "summary": "Ежедневная (каждые 2 дня)",
                  "value": { "title": "Обзвон пациентов", "status": "new", "recurrence": { "type": "daily", "start_at": "2025-07-01", "interval": 2 } }
                },
                "monthly": {
                  "summary": "Ежемесячная (1-го и 15-го)",
                  "value": { "title": "Формирование отчёта", "status": "new", "recurrence": { "type": "monthly", "month_days": [1, 15] } }
                },
                "parity": {
                  "summary": "Чётные дни",
                  "value": { "title": "Инвентаризация", "status": "new", "recurrence": { "type": "parity", "parity": "even" } }
                },
                "specific_dates": {
                  "summary": "Конкретные даты",
                  "value": { "title": "Плановый осмотр", "status": "new", "recurrence": { "type": "specific_dates", "dates": ["2025-07-10", "2025-07-20"] } }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/tasks/{id}/occurrences": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task occurrences",
        "description": "Returns dates when the task should occur within the given range",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date", "example": "2025-07-01" }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date", "example": "2025-07-31" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of dates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string", "format": "date" },
                  "example": ["2025-07-01", "2025-07-03", "2025-07-05"]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "example": "Prepare release" },
          "description": { "type": "string", "example": "Collect release notes and check migrations" },
          "status": { "type": "string", "enum": ["new", "in_progress", "done"], "example": "new" },
          "recurrence": { "$ref": "#/components/schemas/Recurrence" }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": { "type": "string", "example": "Prepare release" },
          "description": { "type": "string", "example": "Collect release notes and check migrations" },
          "status": { "type": "string", "enum": ["new", "in_progress", "done"], "example": "in_progress" },
          "recurrence": { "$ref": "#/components/schemas/Recurrence" }
        }
      },
      "Recurrence": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["daily", "monthly", "specific_dates", "parity"], "example": "daily" },
          "start_at": { "type": "string", "format": "date", "example": "2025-07-01" },
          "interval": { "type": "integer", "example": 2 },
          "month_days": { "type": "array", "items": { "type": "integer" }, "example": [1, 15] },
          "dates": { "type": "array", "items": { "type": "string", "format": "date" }, "example": ["2025-07-10", "2025-07-20"] },
          "parity": { "type": "string", "enum": ["even", "odd"], "example": "even" }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "title": { "type": "string", "example": "Prepare release" },
          "description": {
            "type": "string",
            "example": "Collect release notes and check migrations"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "recurrence": { "$ref": "#/components/schemas/Recurrence" },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "task not found" }
        }
      }
    }
  }
}
